{
  "name": "@graupl/icons",
  "version": "1.0.0-beta.60",
  "license": "GPL-3.0-or-later",
  "description": "A plugin for Graupl that provides bare-minimum icon components.",
  "type": "module",
  "files": [
    "dist",
    "scss",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./scss/icon.scss"
    },
    "./*.scss": {
      "sass": "./scss/*.scss"
    },
    "./src/*.scss": {
      "sass": "./src/scss/*.scss"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/icons.git"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/icons/issues"
  },
  "homepage": "https://github.com/Graupl/icons#readme",
  "scripts": {
    "presass": "rm -rf dist/css/*",
    "precss": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node",
    "css": "node compile-styles.js",
    "build": "npm run build:css",
    "build:css": "npm run css",
    "stylelint": "stylelint '**/*.scss' --allow-empty-input",
    "prettier": "prettier '**/*.{js,mjs,cjs,scss,sass}'",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "pretest:browser": "npm run build:css",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "prepare": "husky",
    "commit": "git cz",
    "eslint": "eslint .",
    "lint": "npm run eslint -- --fix && npm run stylelint -- --fix && npm run prettier --  --write",
    "release": "commit-and-tag-version -a",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@graupl/core": "^1.0.0-beta.60"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "^9.0.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/ui": "4.1.10",
    "commit-and-tag-version": "^12.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.4",
    "globals": "^17.14.0",
    "husky": "^9.0.11",
    "jsdom": "27.4.0",
    "lightningcss": "^1.30.2",
    "lint-staged": "^15.2.2",
    "playwright": "1.62.1",
    "prettier": "^3.2.5",
    "sass": "^1.89.2",
    "sass-embedded": "^1.89.2",
    "stylelint": "^16.3.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-prettier": "^5.0.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
